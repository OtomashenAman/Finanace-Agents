# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env

# Application
APP_NAME="Finance Agent Command Center"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
HOST="0.0.0.0"
PORT=8088
LOG_LEVEL="info"
# text (readable) or json (one object per line, for log shippers; use in production)
LOG_FORMAT="text"
# Bearer token for GET /metrics (Prometheus). Unset: open in development, off in production
METRICS_TOKEN=""
# Several server processes (WEB_CONCURRENCY > 1): shared directory to sum their HTTP counters
METRICS_DIR=""

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me"
# Only needed for extra origins: the SPA is served same-origin via the Vite proxy / nginx
CORS_ORIGINS=[]

# Auth
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# true whenever the app is served over HTTPS (production)
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Overview
REVIEW_SLA_HOURS=24

# Demo users created by `docker compose up` (or: uv run poe seed --finance-team); not in
# production. The password is shared by the Finance POD team (unset in Docker: FinanceDemo!2026)
DEMO_ADMIN_EMAIL="finance.admin@example.com"
DEMO_ADMIN_NAME="Finance Admin"
DEMO_ADMIN_PASSWORD=""

# Local ERPNext for the Finance POD: `docker compose up` starts it, seeds the GIA demo company
# and connects the app (the erpnext-seed service; a new site takes ~10 minutes). Dev and demo
# only: production uses the client's own ERP.
ERPNEXT_PORT=8090
ERPNEXT_ADMIN_PASSWORD="admin"
ERPNEXT_DB_ROOT_PASSWORD="admin"
# The key/secret the seed gives ERPNext's API user and the app connects with (unset: the dev
# defaults in docker-compose.yml)
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""
# Volume name prefix of the local ERPNext (default "erpnext")
ERPNEXT_VOLUMES=""
# A Finance Admin may open a tab as another user to test a workflow (unset: outside production)
ACT_AS_ALLOWED=""
# Hosts an ERPNext connection may use (comma separated; required in production, https only).
# The app in Docker reaches the local ERPNext at http://host.docker.internal:8090
ERPNEXT_ALLOWED_HOSTS=""
# Vendor screening: the OFAC SDN list, downloaded daily (empty: no download; screening then
# refuses to pass a vendor)
SANCTIONS_LIST_URL="https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV"

# Database: PostgreSQL 16 + pgvector everywhere (start locally with: make db-up)
POSTGRES_USER="finance"
POSTGRES_PASSWORD="finance"
POSTGRES_DB="finance_acc"
# Host port of the Docker db (5432/5433 are often taken by other Postgres instances)
POSTGRES_PORT=5434
# Used by the backend when run on the host (make dev-backend, alembic, pytest).
# Inside Docker Compose this is overridden to point at the "db" service.
DATABASE_URL="postgresql+asyncpg://finance:finance@localhost:5434/finance_acc"

# LLM (guarded narratives, server-side only). Provider is pluggable: azure_openai | none
LLM_PROVIDER=azure_openai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1500
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4.1-mini"

# Data sources (QuickBooks connections, finance data uploads)
# Where browsers reach the app; QuickBooks redirects to <this>/api/v1/data-sources/quickbooks/callback.
# Also the origin allowed to make changes (POST/PUT/PATCH/DELETE): other origins get 403
PUBLIC_BASE_URL="http://localhost:8081"
# Encrypts OAuth tokens and client secrets. Required in production; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=""
DATA_SYNC_TIMEOUT_SECONDS=30
UPLOAD_MAX_ROWS=20000

# Uploads: files are never stored, only their extracted text (+ SHA-256)
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_RUN=10
EXTRACTED_TEXT_MAX_CHARS=200000

# Background jobs: queue = run by the worker service; inline = inside the request
JOBS_MODE="queue"
# true: the API process runs the worker itself (hosts without a worker service, e.g. Render free)
JOBS_WORKER_IN_APP=false
# Audit events older than this are removed by: python -m src.app.cli.audit purge
AUDIT_RETENTION_DAYS=2555

# Service POD: read-only source snapshots
POD_SNAPSHOT_MAX_BYTES=5242880
POD_BANK_CSV_MAX_BYTES=2097152
POD_QBXML_MAX_BYTES=10485760
POD_MAX_ROWS_PER_COLLECTION=10000
# SYNTHETIC_DEMO exports / QuickBooks sandbox copies. Empty: allowed outside production only
POD_ALLOW_DEMO_SNAPSHOTS=""

# Service POD: email. outbox = record approved messages, send nothing (labelled simulated);
# brevo = send through Brevo (needs BREVO_API_KEY and a verified EMAIL_SENDER);
# microsoft = send from a Microsoft 365 mailbox through Graph (the AGENT_MS_* below)
EMAIL_PROVIDER="outbox"
EMAIL_SENDER=""
EMAIL_SENDER_NAME="Finance"
BREVO_API_KEY=""
EMAIL_TIMEOUT_SECONDS=20
# Microsoft: an Entra app with Graph application permissions Mail.Send (+ Mail.Read to read
# replies), admin consent given. AGENT_EMAIL_FROM: the From address (default: the mailbox)
AGENT_MS_TENANT_ID=""
AGENT_MS_CLIENT_ID=""
AGENT_MS_CLIENT_SECRET=""
AGENT_MS_MAILBOX=""
AGENT_EMAIL_FROM=""
# Seconds between reads of the mailbox for customer replies (30 or more; empty: by hand)
AGENT_POLL_INTERVAL=""
# While set, every email goes here instead of the customer (the subject names the real one)
EMAIL_TEST_RECIPIENT=""
# Demo / sandbox data: true also lets mail go to each customer's own email from QuickBooks
# (never an edited address). Without it (and no test recipient) sandbox mail is refused
EMAIL_SANDBOX_TO_QUICKBOOKS_CONTACTS=false
# The only addresses internal reports may be sent to, e.g. ["cfo@example.com"]
POD_INTERNAL_RECIPIENTS=[]

# Docker host ports
BACKEND_PORT=8088
FRONTEND_PORT=8081
# true = poll for file changes in Docker dev (use if hot reload misses edits on Windows/macOS)
DOCKER_FILE_POLLING=false
