# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env

# Application
APP_NAME="Finance Agent Command Center"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
HOST="0.0.0.0"
PORT=8088
LOG_LEVEL="info"

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me"
CORS_ORIGINS=["http://localhost:8081"]

# Database: PostgreSQL 16 + pgvector everywhere (start locally with: make db-up)
POSTGRES_USER="finance"
POSTGRES_PASSWORD="finance"
POSTGRES_DB="finance_acc"
POSTGRES_PORT=5434          # host port of the Docker db (5432/5433 are often taken by other Postgres instances)
# Used by the backend when run on the host (make dev-backend, alembic, pytest).
# Inside Docker Compose this is overridden to point at the "db" service.
DATABASE_URL="postgresql+asyncpg://finance:finance@localhost:5434/finance_acc"

# Anthropic / Claude API (guarded narrative generation, server-side only)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5-5"

# Docker host ports
BACKEND_PORT=8088
FRONTEND_PORT=8081
# true = poll for file changes in Docker dev (use if hot reload misses edits on Windows/macOS)
DOCKER_FILE_POLLING=false
