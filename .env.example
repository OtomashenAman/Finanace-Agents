# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env

# Application
APP_NAME="Finance Agent Command Center"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
HOST="0.0.0.0"
PORT=8088
LOG_LEVEL="info"
# text (readable) or json (one object per line, for log shippers; use in production)
LOG_FORMAT="text"
# Bearer token for GET /metrics (Prometheus). Unset: open in development, off in production
METRICS_TOKEN=""
# Several server processes (WEB_CONCURRENCY > 1): shared directory to sum their HTTP counters
METRICS_DIR=""

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me"
# Only needed for extra origins: the SPA is served same-origin via the Vite proxy / nginx
CORS_ORIGINS=[]

# Auth
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# true whenever the app is served over HTTPS (production)
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Overview
REVIEW_SLA_HOURS=24

# Demo user created by: uv run poe seed   (not allowed when ENVIRONMENT=production)
DEMO_ADMIN_EMAIL="finance.admin@example.com"
DEMO_ADMIN_NAME="Finance Admin"
DEMO_ADMIN_PASSWORD=""

# Database: PostgreSQL 16 + pgvector everywhere (start locally with: make db-up)
POSTGRES_USER="finance"
POSTGRES_PASSWORD="finance"
POSTGRES_DB="finance_acc"
# Host port of the Docker db (5432/5433 are often taken by other Postgres instances)
POSTGRES_PORT=5434
# Used by the backend when run on the host (make dev-backend, alembic, pytest).
# Inside Docker Compose this is overridden to point at the "db" service.
DATABASE_URL="postgresql+asyncpg://finance:finance@localhost:5434/finance_acc"

# LLM (guarded narratives, server-side only). Provider is pluggable: azure_openai | none
LLM_PROVIDER=azure_openai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1500
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4.1-mini"

# Data sources (QuickBooks connections, finance data uploads)
# Where browsers reach the app; QuickBooks redirects to <this>/api/v1/data-sources/quickbooks/callback
PUBLIC_BASE_URL="http://localhost:8081"
# Encrypts OAuth tokens and client secrets. Required in production; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=""
DATA_SYNC_TIMEOUT_SECONDS=30
UPLOAD_MAX_ROWS=20000

# Uploads: files are never stored, only their extracted text (+ SHA-256)
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_RUN=10
EXTRACTED_TEXT_MAX_CHARS=200000

# Background jobs: queue = run by the worker service; inline = inside the request
JOBS_MODE="queue"
# true: the API process runs the worker itself (hosts without a worker service, e.g. Render free)
JOBS_WORKER_IN_APP=false
# Audit events older than this are removed by: python -m src.app.cli.audit purge
AUDIT_RETENTION_DAYS=2555

# Docker host ports
BACKEND_PORT=8088
FRONTEND_PORT=8081
# true = poll for file changes in Docker dev (use if hot reload misses edits on Windows/macOS)
DOCKER_FILE_POLLING=false
